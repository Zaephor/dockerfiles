# Retry scenario fixtures for testing retry logic (T005-T009)
# Format: JSON lines, one scenario per line

# Transient failure: 503 Service Unavailable on first push, succeeds on retry
{"scenario": "transient-503-push", "error_code": 503, "error_message": "Service Unavailable", "operation": "docker push", "architecture": "amd64", "attempts": 2, "expected_success_on_attempt": 2}

# Transient failure: Connection timeout, succeeds on retry
{"scenario": "transient-timeout", "error_code": 0, "error_message": "timeout: deadline exceeded", "operation": "docker buildx build", "architecture": "arm64", "attempts": 2, "expected_success_on_attempt": 2}

# Transient failure: Network I/O error, succeeds after 2 retries
{"scenario": "transient-network-io", "error_code": 0, "error_message": "i/o timeout", "operation": "docker push", "architecture": "amd64", "attempts": 3, "expected_success_on_attempt": 3}

# Non-transient failure: Build error (Dockerfile syntax), all retries fail
{"scenario": "non-transient-build-error", "error_code": 1, "error_message": "dockerfile: parse error", "operation": "docker buildx build", "architecture": "amd64", "attempts": 3, "expected_success_on_attempt": 0}

# Non-transient failure: Authentication error, all retries fail
{"scenario": "non-transient-auth-error", "error_code": 401, "error_message": "unauthorized: authentication required", "operation": "docker push", "architecture": "arm64", "attempts": 2, "expected_success_on_attempt": 0}

# Transient failure: Manifest not found (multi-arch coordination), succeeds on retry
{"scenario": "transient-manifest-not-found", "error_code": 404, "error_message": "manifest not found", "operation": "docker buildx imagetools inspect", "architecture": "arm64", "attempts": 2, "expected_success_on_attempt": 2}

# Multi-arch scenario: amd64 succeeds immediately, arm64 transiently fails then succeeds
{"scenario": "multi-arch-mixed", "amd64": {"attempts": 1, "expected_success_on_attempt": 1}, "arm64": {"attempts": 2, "expected_success_on_attempt": 2}, "architecture": "both", "operation": "docker push"}

# Transient failure: Registry rate limit (429 Too Many Requests)
{"scenario": "transient-rate-limit", "error_code": 429, "error_message": "too many requests", "operation": "docker push", "architecture": "amd64", "attempts": 2, "expected_success_on_attempt": 2}
