FROM ghcr.io/catthehacker/ubuntu:act-24.04

# The catthehacker/ubuntu base already ships a complete Docker stack via the
# moby-* packages (moby-engine, moby-cli, moby-buildx, moby-compose,
# moby-containerd, moby-tini). Installing docker.com's docker-ce packages on
# top causes a dpkg file conflict (moby-tini owns /usr/libexec/docker/docker-init),
# so we reuse the base's Docker and only add gosu, which the base lacks and the
# DinD entrypoint needs for privilege drop.
RUN apt-get update && \
    apt-get install -y --no-install-recommends gosu && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Docker auto-start script (for when entrypoint is overridden by runners)
COPY init-docker.sh /usr/local/bin/init-docker.sh
RUN chmod +x /usr/local/bin/init-docker.sh && \
    ln -s /usr/local/bin/init-docker.sh /etc/profile.d/99-docker.sh && \
    echo 'source /usr/local/bin/init-docker.sh' >> /etc/bash.bashrc

# Set BASH_ENV to auto-source init script for non-interactive shells
ENV BASH_ENV=/usr/local/bin/init-docker.sh

# Wrap docker CLI to auto-start dockerd on first use
COPY docker-wrapper.sh /usr/local/bin/docker-wrapper.sh
RUN chmod +x /usr/local/bin/docker-wrapper.sh && \
    mv /usr/bin/docker /usr/bin/docker.real && \
    ln -s /usr/local/bin/docker-wrapper.sh /usr/bin/docker

# Docker-in-Docker entrypoint wrapper
COPY entrypoint-dind.sh /usr/local/bin/entrypoint-dind.sh
RUN chmod +x /usr/local/bin/entrypoint-dind.sh

VOLUME /var/lib/docker

# Health check to verify Docker daemon is responsive
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD docker info >/dev/null 2>&1 || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint-dind.sh"]
CMD ["/bin/bash"]
